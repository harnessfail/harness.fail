{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 80,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "quoteProps": "consistent",
  "trailingComma": "all",
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": "*.css",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
